    "page_fetch": {
      "_설명": "S3 Zyte 호출 설정(사람 유지). 재시도 횟수·대기·제한 시간은 10월 zyte_run.py와 같다. geolocation_alias는 콘솔 국가 코드를 Zyte 국가 코드로 바꾼다.",
      "api_url": "https://api.zyte.com/v1/extract",
      "timeout_seconds": 180,
      "retries": 3,
      "retry_codes": [
        429,
        500,
        503,
        520,
        521
      ],
      "backoff_seconds": 5,
      "workers": 60,
      "workers_per_retailer": 15,
      "_동시수": "11-18 실제 회차에서 30·10 → 60·15로 올림. 남은 곳이 적어지면 곳별 10자리 제한 때문에 OTTO·FALABELLA가 1분에 2~10건으로 느렸다.",
      "log_every": 200,
      "methods": {
        "zyte_html": {
          "httpResponseBody": true
        },
        "zyte_browser": {
          "browserHtml": true
        }
      },
