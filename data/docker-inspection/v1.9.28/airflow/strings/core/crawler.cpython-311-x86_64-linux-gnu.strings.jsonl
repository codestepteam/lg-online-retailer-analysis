{"offset": "0x56920", "text": "(requirePositive) => {\n            const out = {};\n            for (const s of document.querySelectorAll('script[type=\"application/ld+json\"]')) {\n                try {\n                    const data = JSON.parse(s.innerText);\n                    const nodes = Array.isArray(data) ? data : (data['@graph'] || [data]);\n                    for (const n of nodes) {\n                        if (!n || (n['@type'] !== 'Product' && n['@type'] !== 'ProductGroup')) continue;\n                        let offers = n.offers || {};\n                        if (Array.isArray(offers)) offers = offers[0] || {};\n                        if (offers.price != null && (!requirePositive || Number(offers.price) > 0))\n                            out.price = String(offers.price);\n                        if (offers.availability) out.inventory = String(offers.availability).split('/').pop();\n                        const agg = n.aggregateRating || {};\n                        if (agg.ratingValue != null) {\n                            out.rating = agg.ratingValue;\n                            out.review_count = agg.reviewCount || agg.ratingCount || null;\n                        }\n                    }\n                } catch (e) {}\n            }\n            return out;\n        }"}
{"offset": "0x56e20", "text": "<(?:link|a)[^>]+rel=[\"\\']next[\"\\'][^>]+href=[\"\\']([^\"\\']+)[\"\\']|<(?:link|a)[^>]+href=[\"\\']([^\"\\']+)[\"\\'][^>]+rel=[\"\\']next[\"\\']"}
{"offset": "0x56ea0", "text": "() => {\n            const found = [];\n            const videoExts = ['.mp4', '.webm', '.m4v', '.m3u8', '.mpd', '.ts'];\n            document.querySelectorAll('script').forEach(s => {\n                const text = s.textContent || '';\n                const matches = text.match(/https?:\\/\\/[^\"'\\s]+/g) || [];\n                matches.forEach(u => {\n                    const lower = u.toLowerCase();\n                    if (videoExts.some(ext => lower.includes(ext))) {\n                        found.push(u.replace(/\\\\u002F/g, '/'));\n                    }\n                });\n            });\n            return [...new Set(found)];\n        }"}
