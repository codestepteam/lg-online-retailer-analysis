{"offset": "0x185e0", "text": "() => {\n        const out = {};\n        const g = (sel) => {\n            const el = document.querySelector(sel);\n            if (!el) return null;\n            return (el.getAttribute('content') || el.textContent || '').trim() || null;\n        };\n        const price = g('[itemprop=price]');       if (price) out.price = price;\n        const avail = g('[itemprop=availability]'); if (avail) out.inventory = avail.split('/').pop();\n        const rat = g('[itemprop=ratingValue]');    if (rat) out.rating = rat;\n        const rev = g('[itemprop=reviewCount]');    if (rev) out.review_count = rev;\n        return out;\n    }"}
