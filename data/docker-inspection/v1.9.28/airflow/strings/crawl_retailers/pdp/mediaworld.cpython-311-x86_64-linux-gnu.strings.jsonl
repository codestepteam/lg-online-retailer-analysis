{"offset": "0x15520", "text": "script[type=\"application/ld+json\"]"}
{"offset": "0x15550", "text": "crawl_retailers.pdp.mediaworld"}
{"offset": "0x15580", "text": "() => {\n        const out = {};\n        const isProduct = (n) => {\n            if (!n) return false;\n            const t = Array.isArray(n['@type']) ? n['@type'] : [n['@type']];\n            return t.includes('Product') || t.includes('ProductGroup');\n        };\n        for (const s of document.querySelectorAll('script[type=\"application/ld+json\"]')) {\n            let data; try { data = JSON.parse(s.innerText); } catch (e) { continue; }\n            const nodes = Array.isArray(data) ? data : (data['@graph'] || [data]);\n            for (const raw of nodes) {\n                const n = isProduct(raw) ? raw\n                    : (raw && isProduct(raw.object) ? raw.object : null);\n                if (!n) continue;\n                let offers = n.offers || {};\n                if (Array.isArray(offers)) offers = offers[0] || {};\n                if (offers.price != null) out.price = String(offers.price);\n                if (offers.availability) out.inventory = String(offers.availability).split('/').pop();\n                const agg = n.aggregateRating || {};\n                if (agg.ratingValue != null) {\n                    out.rating = agg.ratingValue;\n                    out.review_count = agg.reviewCount || agg.ratingCount || null;\n                }\n                const g = n.gtin13 || n.gtin || n.gtin14 || n.gtin8;\n                if (g) out._ean = String(g);\n            }\n        }\n        return out;\n    }"}
