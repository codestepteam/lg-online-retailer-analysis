{"offset": "0x17780", "text": "() => {\n        const out = {};\n        const numOf = (el) => {\n            if (!el) return null;\n            const m = el.textContent.match(/[\\d.,]+/);\n            return m ? m[0] : null;\n        };\n        const cur = numOf(document.querySelector('.current-price'));\n        const sugg = numOf(document.querySelector('.price-comparison .suggested-price'));\n        if (sugg) {\n            out.price = sugg;\n            if (cur) out.discount_price = cur;\n        } else if (cur) {\n            out.price = cur;\n        }\n\n        const avail = document.querySelector('.availability-wrapper > span');\n        if (avail) out.inventory = avail.textContent.trim();\n\n        for (const s of document.querySelectorAll('script[type=\"application/ld+json\"]')) {\n            try {\n                const data = JSON.parse(s.textContent);\n                if (data && data['@type'] === 'Product' && data.aggregateRating) {\n                    out.rating = data.aggregateRating.ratingValue;\n                    out.review_count = data.aggregateRating.reviewCount;\n                }\n            } catch (e) {}\n        }\n        return out;\n    }"}
