{"offset": "0x1d7e0", "text": "script[type=\"application/ld+json\"]"}
{"offset": "0x1d820", "text": "() => {\n        for (const s of document.querySelectorAll('script[type=\"application/ld+json\"]')) {\n            let d; try { d = JSON.parse(s.textContent); } catch (e) { continue; }\n            const g = d && (d.gtin13 || d.gtin || d.gtin14 || d.gtin12 || d.ean);\n            if (g) return String(g);\n        }\n        return null;\n    }"}
{"offset": "0x1d980", "text": "() => {\n        const out = {};\n        for (const s of document.querySelectorAll('script[type=\"application/ld+json\"]')) {\n            let data;\n            try { data = JSON.parse(s.textContent); } catch (e) { continue; }\n            if (!data) continue;\n\n            if (data['@type'] === 'Product' && data.offers) {\n                const offers = data.offers;\n                if (offers.price != null) out.price = offers.price;\n                const specs = offers.priceSpecification || [];\n                const sale = specs.find(p => (p.priceType || '').endsWith('SalePrice'));\n                if (sale && sale.price != null) out.discount_price = sale.price;\n                if (offers.availability) out.inventory = offers.availability.split('/').pop();\n            }\n\n            if (data.aggregateRating) {\n                out.rating = parseFloat(data.aggregateRating.ratingValue);\n                out.review_count = parseInt(data.aggregateRating.reviewCount, 10);\n            }\n        }\n\n        // aggregateRating JSON-LD 는 Bazaarvoice 위젯이 비동기로 늦게 주입하는 경우가\n        // 있어(실측: 크롤 시점엔 없고 DOM 위젯만 렌더된 상태) 못 잡을 때가 있다.\n        // 위젯이 실제로 그려낸 schema.org 마이크로데이터(itemprop)를 폴백으로 읽는다\n        // — #aside 안 `.bazaar_voice__stars` 위젯의 ratingValue(div 텍스트) / reviewCount(meta content).\n        if (out.rating == null) {\n            const el = document.querySelector('[itemprop=\"ratingValue\"]');\n            if (el) {\n                const v = parseFloat((el.getAttribute('content') || el.textContent || '').replace(',', '.'));\n                if (!Number.isNaN(v)) out.rating = v;\n            }\n        }\n        if (out.review_count == null) {\n            const el = document.querySelector('[itemprop=\"reviewCount\"]');\n            if (el) {\n                const n = parseInt((el.getAttribute('content') || el.textContent || '').replace(/\\D/g, ''), 10);\n                if (!Number.isNaN(n)) out.review_count = n;\n            }\n        }\n        return out;\n    }"}
