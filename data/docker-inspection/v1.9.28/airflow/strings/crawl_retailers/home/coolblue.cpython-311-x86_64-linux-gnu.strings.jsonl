{"offset": "0x1c540", "text": "\n() => {\n  for (const a of document.querySelectorAll('a[href]')) {\n    try {\n      if (new URL(a.href).pathname.replace(/\\/$/, '').endsWith('/filter')) return a.href;\n    } catch (e) {}\n  }\n  return null;\n}\n"}
{"offset": "0x1c620", "text": "\nasync (page2Url) => {\n  try {\n    const resp = await fetch(page2Url, {credentials: 'include', headers: {'Accept': 'text/html'}});\n    if (!resp.ok) return {added: 0, status: resp.status};\n    const txt = await resp.text();\n    const doc = new DOMParser().parseFromString(txt, 'text/html');\n    const first = document.querySelector('.product-card');\n    const grid = first ? first.parentElement : document.body;\n    const seen = new Set();\n    document.querySelectorAll('.product-card').forEach(c => {\n      const a = c.querySelector('a[href]');\n      if (a) seen.add(a.getAttribute('href'));\n    });\n    let added = 0;\n    for (const c of doc.querySelectorAll('.product-card')) {\n      const a = c.querySelector('a[href]');\n      const href = a ? a.getAttribute('href') : null;\n      if (href && seen.has(href)) continue;\n      if (href) seen.add(href);\n      grid.appendChild(document.importNode(c, true));\n      added++;\n    }\n    return {added, page2: doc.querySelectorAll('.product-card').length};\n  } catch (e) { return {error: String(e)}; }\n}\n"}
