{"offset": "0x23840", "text": "\nasync (page2Url) => {\n  try {\n    const SEL = 'div[data-component-type=\"s-search-result\"]';\n    const resp = await fetch(page2Url, {credentials: 'include', headers: {'Accept': 'text/html'}});\n    if (!resp.ok) return {added: 0, status: resp.status};\n    const txt = await resp.text();\n    const doc = new DOMParser().parseFromString(txt, 'text/html');\n    const first = document.querySelector(SEL);\n    if (!first) return {added: 0, noGrid: true};\n    const grid = first.parentElement;\n    const seen = new Set([...document.querySelectorAll(SEL)]\n      .map(c => c.getAttribute('data-asin')).filter(Boolean));\n    let added = 0;\n    for (const c of doc.querySelectorAll(SEL)) {\n      const a = c.getAttribute('data-asin');\n      if (a && seen.has(a)) continue;\n      if (a) seen.add(a);\n      grid.appendChild(document.importNode(c, true));\n      added++;\n    }\n    return {added, page2: doc.querySelectorAll(SEL).length};\n  } catch (e) { return {error: String(e)}; }\n}\n"}
