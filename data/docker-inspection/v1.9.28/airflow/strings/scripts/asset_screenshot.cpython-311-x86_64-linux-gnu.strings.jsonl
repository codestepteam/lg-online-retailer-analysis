{"offset": "0x6d7a0", "text": "(sel) => {\n    const r = document.querySelector(sel); if (!r) return false;\n    if (r.querySelectorAll('img').length > 0) return true;\n    if ((r.innerText || '').trim().length > 20) return true;\n    const iframes = Array.from(r.querySelectorAll('iframe'));\n    return iframes.some(f => {\n        const src = f.src || f.getAttribute('src') || '';\n        return /flix/i.test(src);\n    });\n}"}
{"offset": "0x6d940", "text": "(sel) => {\n    const e = document.querySelector(sel);\n    if (!e) return null;\n    const r = e.getBoundingClientRect();\n    // 가장 가까운 스크롤 조상(ion-content 포함)의 가시 박스 — 앱셸 헤더/검색바는\n    // 이 컨테이너 밖이라, 스트립을 이 박스로 clamp 하면 자연 배제된다.\n    let sc = e.parentElement, ctop = 0, cbottom = window.innerHeight;\n    while (sc) {\n        if (sc.tagName === 'ION-CONTENT' || sc.scrollHeight > sc.clientHeight + 50) {\n            const b = sc.getBoundingClientRect();\n            ctop = b.top; cbottom = b.bottom;\n            break;\n        }\n        sc = sc.parentElement;\n    }\n    return {top: r.top, bottom: r.bottom, left: r.left, right: r.right,\n            ctop: ctop, cbottom: cbottom,\n            docScrollH: document.documentElement.scrollHeight,\n            vh: window.innerHeight, vw: window.innerWidth};\n}"}
{"offset": "0x6dce0", "text": "\n            #onetrust-consent-sdk, #onetrust-banner-sdk,\n            #CybotCookiebotDialog, .iubenda-cs-container {\n                display: none !important;\n            }\n        "}
{"offset": "0x6dda0", "text": "() => {\n    let n = 0;\n    for (const v of Array.from(document.querySelectorAll('video[poster]'))) {\n        const poster = v.getAttribute('poster');\n        if (!poster) continue;\n        // 숨김 변형(모바일용 display:none 등)은 치환하면 오히려 보이게 되어 같은\n        // 모듈이 두 번 찍힌다 — 진짜 숨김만 건너뛴다. ⚠️ rect 크기 기준 금지:\n        // 라이브 경로에선 보이는 비디오도 치환 시점엔 소스 미로드로 0×0 이라\n        // (2026-08-05 Unieuro 실측 — rect 필터를 썼더니 비디오가 전부 다시\n        // 누락됐다) computed display/visibility 로만 판정한다.\n        const cs = getComputedStyle(v);\n        if (cs.display === 'none' || cs.visibility === 'hidden') continue;\n        const img = document.createElement('img');\n        img.src = poster.startsWith('//') ? 'https:' + poster : poster;\n        img.className = v.className;\n        img.style.width = '100%';\n        img.style.height = 'auto';\n        img.style.display = 'block';\n        v.replaceWith(img);\n        n++;\n    }\n    return n;\n}"}
