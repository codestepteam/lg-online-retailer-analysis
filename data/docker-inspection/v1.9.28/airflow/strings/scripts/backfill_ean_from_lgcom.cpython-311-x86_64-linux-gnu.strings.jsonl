{"offset": "0x222c0", "text": "INSERT INTO product_ean (model_mpc, ean, source) VALUES (%s,%s,%s) ON DUPLICATE KEY UPDATE model_mpc=model_mpc"}
{"offset": "0x22340", "text": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"}
{"offset": "0x22380", "text": "scripts.backfill_ean_from_lgcom"}
{"offset": "0x223a0", "text": "\n        SELECT UPPER(p.sales_model_code) AS model,\n               SUBSTRING(p.locale, 1, 2) AS cc, p.url\n          FROM pdp_20260622 p\n          LEFT JOIN product_ean e ON e.model_mpc = UPPER(p.sales_model_code)\n         WHERE e.model_mpc IS NULL\n               AND SUBSTRING(p.locale, 1, 2) IN ("}
{"offset": "0x224e0", "text": ")\n               AND p.url IS NOT NULL AND p.url <> ''\n         GROUP BY model, cc, p.url\n         ORDER BY cc, model\n    "}
